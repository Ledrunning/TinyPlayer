<ui:FluentWindow
    x:Class="TinyPlayer.Desktop.View.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:TinyPlayer.Desktop.Controls"
    xmlns:converters="clr-namespace:TinyPlayer.Desktop.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:viewmodel="clr-namespace:TinyPlayer.Desktop.ViewModel"
    Title="TinyPlayer"
    Width="900"
    Height="550"
    Closed="Window_Closed"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <Window.Resources>
        <converters:BoolToPlayPauseConverter x:Key="BoolToPlayPauseConverter" />
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="72" />
        </Grid.RowDefinitions>

        <ui:TitleBar
            Title="TinyPlayer"
            Grid.Row="0"
            Margin="0,0,0,0">
            <ui:TitleBar.Header>
                <ui:Button
                    Margin="0,0,0,0"
                    Appearance="Transparent"
                    Command="{Binding OpenFileCommand}"
                    Icon="{ui:SymbolIcon FolderOpen24}"
                    ToolTip="Open file" />
            </ui:TitleBar.Header>
        </ui:TitleBar>

        <Grid Grid.Row="1">
            <controls:VideoHost x:Name="VideoSurface" />
        </Grid>

        <Border
            Grid.Row="2"
            Margin="12,0,12,12"
            Background="{DynamicResource ControlFillColorSecondaryBrush}"
            CornerRadius="12,12,0,0">
            <Grid Margin="12,0" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <!--  0: Play/Pause  -->
                    <ColumnDefinition Width="Auto" />
                    <!--  1: Stop  -->
                    <ColumnDefinition Width="Auto" />
                    <!--  2: Mute  -->
                    <ColumnDefinition Width="100" />
                    <!--  3: Volume  -->
                    <ColumnDefinition Width="*" />
                    <!--  4: Progress  -->
                    <ColumnDefinition Width="Auto" />
                    <!--  5: Time  -->
                </Grid.ColumnDefinitions>

                <!--  Play/Pause  -->
                <ui:Button
                    Grid.Column="0"
                    Width="60"
                    Height="35"
                    Margin="0,0,6,0"
                    Appearance="Primary"
                    Command="{Binding TogglePlayPauseCommand}"
                    Content="{Binding IsPlaying, Converter={StaticResource BoolToPlayPauseConverter}}"
                    FontSize="24" />

                <!--  Stop  -->
                <ui:Button
                    Grid.Column="1"
                    Width="60"
                    Height="35"
                    Margin="0,0,6,0"
                    Appearance="Primary"
                    Command="{Binding StopCommand}"
                    Content="■"
                    FontSize="24" />

                <!--  Mute  -->
                <ui:Button
                    Grid.Column="2"
                    Width="38"
                    Height="35"
                    Margin="0,0,4,0"
                    Appearance="Transparent"
                    Command="{Binding ToggleMuteCommand}"
                    Icon="{ui:SymbolIcon Speaker224}" />

                <!--  Volume  -->
                <Slider
                    Grid.Column="3"
                    VerticalAlignment="Center"
                    IsMoveToPointEnabled="True"
                    Maximum="100"
                    Minimum="0"
                    Value="{Binding Volume, Mode=TwoWay}" />

                <!--  Progress — занимает всё свободное место  -->
                <Slider
                    Grid.Column="4"
                    Margin="8,0"
                    VerticalAlignment="Center"
                    IsMoveToPointEnabled="True"
                    Maximum="{Binding Duration}"
                    Minimum="0"
                    PreviewMouseDown="OnSeekStarted"
                    PreviewMouseUp="OnSeekCompleted"
                    Value="{Binding Position, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <!--  Time  -->
                <TextBlock
                    Grid.Column="5"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="{Binding TimeText}" />
            </Grid>
        </Border>

    </Grid>
</ui:FluentWindow>
