<ui:FluentWindow
    x:Class="TinyPlayer.Desktop.View.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:TinyPlayer.Desktop.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:viewmodel="clr-namespace:TinyPlayer.Desktop.ViewModel"
    Title="TinyPlayer"
    Width="900"
    Height="550"
    Closed="Window_Closed"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">

    <Window.DataContext>
        <viewmodel:MainViewModel />
    </Window.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="72" />
        </Grid.RowDefinitions>

        <ui:TitleBar
            Title="TinyPlayer"
            Grid.Row="0"
            Margin="42,0,0,0">
            <ui:TitleBar.Header>
                <ui:Button
                    Margin="4,0,0,0"
                    Appearance="Transparent"
                    Command="{Binding OpenFileCommand}"
                    Icon="{ui:SymbolIcon FolderOpen24}"
                    ToolTip="Открыть файл" />
            </ui:TitleBar.Header>
        </ui:TitleBar>

        <Border
            Grid.Row="1"
            Margin="12"
            ClipToBounds="True"
            CornerRadius="8">
            <controls:VideoPanel x:Name="VideoHost" />
        </Border>

        <Border
            Grid.Row="2"
            Margin="12,0,12,12"
            Background="{DynamicResource ControlFillColorSecondaryBrush}"
            CornerRadius="12,12,0,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ui:Button
                    Grid.Column="0"
                    Width="60"
                    Height="35"
                    Margin="12,0,6,0"
                    Appearance="Primary"
                    Command="{Binding PlayCommand}"
                    Content="▶"
                    FontSize="24" />

                <ui:Button
                    Grid.Column="1"
                    Width="60"
                    Height="35"
                    Margin="0,0,6,0"
                    Appearance="Primary"
                    Command="{Binding PauseCommand}"
                    Content="⏸"
                    FontSize="24" />

                <ui:Button
                    Grid.Column="2"
                    Width="60"
                    Height="35"
                    Margin="0,0,6,0"
                    Appearance="Primary"
                    Command="{Binding StopCommand}"
                    Content="■"
                    FontSize="24" />

                <ui:Button
                    Grid.Column="3"
                    Width="60"
                    Height="35"
                    Margin="0,0,6,0"
                    Appearance="Secondary"
                    Command="{Binding OpenFileCommand}"
                    Icon="{ui:SymbolIcon FolderOpen24}"
                    ToolTip="Открыть файл" />

                <Slider
                    Grid.Column="4"
                    Margin="12,0"
                    VerticalAlignment="Center"
                    IsMoveToPointEnabled="True"
                    Maximum="{Binding Duration}"
                    Minimum="0"
                    Value="{Binding Position, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock
                    Grid.Column="5"
                    Margin="0,0,12,0"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="{Binding TimeText}" />
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
